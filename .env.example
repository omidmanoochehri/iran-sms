# Copy to `.env` and fill in only the providers you actually use.
# `.env` is git-ignored — never commit real credentials.
#
# This file exists so that every example in the repository can read its credentials from
# the environment rather than having them written into source.

# --- providers with a published, fixed API host -----------------------------------------
IPPANEL_API_KEY=
FARAZSMS_API_KEY=
KAVENEGAR_API_KEY=
SMSIR_API_KEY=
AMOOT_TOKEN=

MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=

FARAPAYAMAK_USERNAME=
FARAPAYAMAK_PASSWORD=

SHAHVARPAYAM_USERNAME=
SHAHVARPAYAM_PASSWORD=

MIZBANSMS_USERNAME=
MIZBANSMS_PASSWORD=

# --- providers whose API host must be supplied from your own panel ----------------------
# See docs/providers/<id>.md for why each of these needs an explicit base URL.
MEDIANA_API_KEY=
MEDIANA_BASE_URL=

TABANSMS_API_KEY=
TABANSMS_BASE_URL=

SMSARAM_API_KEY=
SMSARAM_BASE_URL=

YEKPAYAMAK_API_KEY=
YEKPAYAMAK_BASE_URL=

# --- default sender line used by the examples -------------------------------------------
SMS_SENDER=

# --- optional integration tests (disabled by default) -----------------------------------
# Set to "true" and provide credentials above to exercise the live APIs.
SMS_INTEGRATION_TESTS=false
# A number you own and are happy to receive test messages on.
SMS_INTEGRATION_RECIPIENT=
